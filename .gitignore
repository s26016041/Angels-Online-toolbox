# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# 執行時產物
captures/
*.log

# 封包擷取 / 記憶體除錯產物（大檔、非原始碼）
*.etl
*.pcapng
*.dmp

# 打包輸出
build/
dist/
*.spec
# 例外：這支是手維護的建置設定（release.py / build_local.py 都靠它，
# 內含白屏修復 collect_submodules('app')），必須納入版控。
!AngelsOnlineToolbox.spec

# 逆向 / 分析用的臨時腳本，不進版控
scratchpad/

# 分析工具的傾印輸出（tools/dump_lua_globals.py 等），可隨時重生
reports/

# 丟在根目錄用來回報問題的截圖（aaaa.png、153.png…）。
# 只擋根目錄，assets/ 底下的圖不受影響。留著它們會讓 release.py 以為有未提交變更。
/*.png

# 編輯器 / 系統
.vscode/
.idea/
.DS_Store
Thumbs.db

# 遊戲自己的資料夾（從遊戲目錄複製進來的，不是專案的東西）
SETTING/
